<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TesteImpressao.BluetoothDevicesPage"
             Title="Dispositivos Bluetooth">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Selecione um dispositivo Bluetooth" Style="{StaticResource Title}" />

            <Picker x:Name="DevicesPicker"
                    Title="Dispositivos encontrados"
                    ItemDisplayBinding="{Binding Display}" />

            <Button Text="Refresh" Clicked="OnRefreshClicked" />

            <Button Text="Conectar e imprimir teste" Clicked="OnConnectAndPrintClicked" />

            <Label x:Name="StatusLabel"
                   Text="Nenhum dispositivo carregado."
                   FontSize="14"
                   TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
